TELEGRAM_BOT_TOKEN=
TIMEZONE=Asia/Riyadh
SCAN_INTERVAL_MINUTES=15
YFINANCE_PERIOD=5d
YFINANCE_INTERVAL=15m
MAX_DATA_AGE_MINUTES=45
DEFAULT_RISK_PERCENT=1.0
EMA_FAST=20
EMA_SLOW=50
# Broker/MT5-specific values: configure these per symbol for meaningful lot sizing.
CONTRACT_UNITS_PER_LOT=100000
PRICE_VALUE_PER_UNIT=1.0
NEWS_FILTER_REQUIRED=1
NEWS_EVENTS_FILE=data/news_events.json
# Optional HTTPS JSON endpoint with {"events":[{"time":"...Z","impact":"high","currencies":["USD"],"title":"CPI"}]}
NEWS_EVENTS_URL=
NEWS_BLACKOUT_MINUTES=30
DXY_SYMBOL=DX-Y.NYB
# Yahoo Finance reference feed works directly on Termux.
PRICE_PROVIDER=yahoo
# Optional HTTPS broker/MT5 bridge endpoint; unused when PRICE_PROVIDER=yahoo.
BROKER_FEED_URL=
BROKER_FEED_TOKEN=
BROKER_FEED_TIMEOUT_SECONDS=8
# Enabled so the bot remains independent when no bridge is configured.
ALLOW_PUBLIC_FALLBACK=1
